# -*- mode: ruby -*-

# Vagrantfile for configuring virtual machine infrastructure using Vagrant
#
# This file uses Vagrant configuration API version 2, which is the current standard
# for defining Vagrant environments. API version 2 provides support for:
# - Multiple provider backends (VirtualBox, VMware, AWS, etc.)
# - Multiple virtual machines in a single configuration
# - Improved syntax and configuration options compared to API version 1
# - Better provisioning and networking capabilities
#
# The version 2 API is specified by passing "2" to Vagrant.configure()


# Configure Vagrant with version 2 API
Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"
  # Give SSH more time to come up than the 300s default before Vagrant gives
  # up — headroom for a slow/loaded lab machine.
  config.vm.boot_timeout = 600

  # Shared secret used by both nodes to join the same K3s cluster. Fixing it
  # here means the worker doesn't have to wait on the synced folder to see a
  # token generated by the server.
  k3s_token = "iot-k3s-cluster-token"

  # SERVER (S)
  config.vm.define "jhogoncaS" do |s|
    s.vm.hostname = "jhogoncaS"
    s.vm.network "private_network", ip: "192.168.56.110"
    s.vm.provider "virtualbox" do |vb|
      # The subject's "1 CPU / 512MB (or 1024)" guidance was sized for the
      # k3s release in its own screenshots (v1.21.4, ~2021); current stable
      # k3s (v1.36.x) starved and thrashed at that budget with the full
      # default addon set (traefik/metrics-server/servicelb) also fighting
      # for RAM — see TROUBLESHOOTING.md. 2048MB first fixed the thrashing,
      # but with those unused addons now disabled (see setup_server.sh —
      # p1's own scope needs only the API server/kine/scheduler/
      # controller-manager/coredns), this was re-tested lower (2026-09-08):
      # 1280MB worked (load average 0.23, zero OOM events over 3+ minutes)
      # but left only ~300Mi available — tight if something extra needs to
      # run during the defense. 1536MB keeps the same addon savings with
      # more headroom (~25% cut from the original 2048MB instead of 37%).
      # Revert to 2048 if this ever proves unstable.
      vb.memory = "1536"
      vb.cpus = 1
    end
    s.vm.provision "shell", path: "scripts/setup_server.sh", env: { "K3S_TOKEN" => k3s_token }
  end

  # WORKER (SW)
  config.vm.define "jhogoncaSW" do |sw|
    sw.vm.hostname = "jhogoncaSW"
    sw.vm.network "private_network", ip: "192.168.56.111"
    sw.vm.provider "virtualbox" do |vb|
      # Tested at 768MB (2026-09-08): the VM never finished booting within
      # boot_timeout — ubuntu/jammy64 itself (systemd/cloud-init, before k3s
      # is even installed) doesn't converge at that budget, unlike the
      # server this isn't a k3s addon problem (the agent doesn't run
      # traefik/metrics-server/servicelb anyway), so there's nothing to trim
      # here. 1024MB is the confirmed-working floor for this box.
      vb.memory = "1024"
      vb.cpus = 1
    end
    sw.vm.provision "shell", path: "scripts/setup_worker.sh", env: { "K3S_TOKEN" => k3s_token }
  end
end