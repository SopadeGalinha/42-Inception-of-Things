# -*- mode: ruby -*-
#
# Vagrantfile for Part 3: K3d and Argo CD
#
# The subject requires "the whole project" (Part 3 included — see its own
# "install K3d on your virtual machine" wording) to run inside a VM, not on
# the bare host. Unlike p1/p2, this VM doesn't run VirtualBox internally (no
# Vagrant/K3s in here, just Docker + k3d), so it's plain single-level
# virtualization — no nested-hw-virt flag needed, same as bonus's own VM.
#
# Single provisioner block: Vagrant reuses the same SSH session across
# separate `config.vm.provision "shell"` blocks (confirmed — splitting
# install_dependencies.sh into its own block did NOT dodge the docker-group
# timing issue below), so there's no benefit to splitting it. setup.sh's own
# verify_prerequisites() handles the group-membership timing itself via
# `sg docker`, see the comment there.
Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"

  # Named "jhogoncaS" (not "jhogoncaP3") to match the same login+S pattern
  # p1/p2 use — the subject doesn't require a specific hostname for p3, but
  # there's no reason not to keep it visually consistent across parts.
  # `config.vm.define` (not just `config.vm.hostname`) matters here: without
  # it Vagrant's own machine identifier stays "default" even though the
  # guest hostname is right, so `vagrant status`/`.vagrant/machines/` don't
  # match p1/p2's naming either.
  config.vm.define "jhogoncaS" do |s|
    s.vm.hostname = "jhogoncaS"
    s.vm.network "private_network", ip: "192.168.56.120"

    s.vm.provider "virtualbox" do |vb|
      # Matches the size already validated for p3 in TROUBLESHOOTING.md
      # ("tested successfully in a throwaway single VM (4096MB/2 CPU,
      # generous headroom — not tuned down to a minimum since p3 has no
      # prescribed VM sizing in the subject)").
      vb.memory = "4096"
      vb.cpus = 2
    end

    # inline + explicit /vagrant path (not `path:`, which copies the script
    # to a /tmp/vagrant-shell* path first) so setup.sh's own
    # BASH_SOURCE-relative lookup of ../confs/argocd-app.yaml still resolves
    # correctly.
    s.vm.provision "shell", privileged: false, inline: "bash /vagrant/scripts/setup.sh"
  end
end
