Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"

  config.vm.define "jhogoncaS" do |s|
    s.vm.hostname = "jhogoncaS"
    s.vm.network "private_network", ip: "192.168.56.120"

    s.vm.provider "virtualbox" do |vb|
      vb.memory = "4096"
      vb.cpus = 2
    end

    # `vagrant up` only boots and preps the VM for login
    # log in (`vagrant ssh`, or VirtualBox GUI with jhogonca/qwerty123)
    # `iot-setup` (alias for `bash /vagrant/scripts/setup.sh`).
    s.vm.provision "shell", privileged: true, inline: <<-SHELL
      id jhogonca &>/dev/null || useradd -m -s /bin/bash jhogonca
      echo "jhogonca:qwerty123" | chpasswd
      usermod -aG sudo jhogonca
      echo "jhogonca ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/jhogonca
      chmod 440 /etc/sudoers.d/jhogonca

      for home in /home/vagrant /home/jhogonca; do
        grep -qxF 'alias iot-setup="bash /vagrant/scripts/setup.sh"' "$home/.bashrc" || \
          echo 'alias iot-setup="bash /vagrant/scripts/setup.sh"' >> "$home/.bashrc"
        grep -qxF 'alias argocd-password=' "$home/.bashrc" || \
          echo 'alias argocd-password='"'"'kubectl -n argocd get secret argocd-initial-admin-secret -o jsonpath="{.data.password}" | base64 -d; echo'"'"'' >> "$home/.bashrc"
        grep -qxF 'alias k=kubectl' "$home/.bashrc" || echo 'alias k=kubectl' >> "$home/.bashrc"
        grep -qxF 'source <(kubectl completion bash)' "$home/.bashrc" || echo 'source <(kubectl completion bash)' >> "$home/.bashrc"
        grep -qxF 'complete -o default -F __start_kubectl k' "$home/.bashrc" || echo 'complete -o default -F __start_kubectl k' >> "$home/.bashrc"
      done

      {
        echo ""
        echo "Part 3 (K3d + Argo CD) is NOT installed yet."
        echo "Run:            iot-setup"
        echo "(or:            bash /vagrant/scripts/setup.sh)"
        echo "Argo CD admin password, any time after setup: argocd-password"
        echo ""
      } > /etc/motd
    SHELL
  end
end
